<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Reuse the port's pure logic (no relay / backend / docker). -->
  <ItemGroup>
    <Compile Include="../../../src/ModelRouter/ModelParser.cs" Link="src/ModelParser.cs" />
    <Compile Include="../../../src/ModelRouter/Media.cs" Link="src/Media.cs" />
    <Compile Include="../../../src/ModelRouter/Profiles.cs" Link="src/Profiles.cs" />
    <Compile Include="../../../src/ModelRouter/Routing.cs" Link="src/Routing.cs" />
    <Compile Include="../../../src/ModelRouter/Effort.cs" Link="src/Effort.cs" />
  </ItemGroup>

</Project>
